# SonicBoom Environment Configuration Example
#
# Copy to `.env` and edit. NEVER commit a real `.env` (it is gitignored).
# Generate a strong admin password, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Server Configuration ---
# Server port
PORT=3000
# Admin panel username
SONICBOOM_ADMIN_ID=admin
# Admin panel password (REQUIRED, minimum 12 characters, no default).
# The server refuses to start when this is missing or weak.
# Generate one and paste it here; never commit a real password:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
SONICBOOM_ADMIN_PW=

# --- Model Configuration ---
# Directory where models will be downloaded and cached
MODEL_CACHE_DIR=./models
# Pinned HuggingFace revision: must be a 40-char commit SHA (never main/tags).
# Default is the audited pin with built-in trusted hashes; a custom revision
# REQUIRES MODEL_SHA256_JSON_PATH with a complete manifest for that revision.
# MODEL_REVISION=3cadd1ee6394adea1bd021217a0e650ede09a323
# Optional custom JSON manifest of expected SHA-256 digests per model file.
# Must be complete and valid; the built-in manifest covers the default revision.
# MODEL_SHA256_JSON_PATH=./models.sha256.json
# HuggingFace token for private models (optional if models are public)
# HF_TOKEN=your_huggingface_token_here
# Number of inference steps (1-50; 1-3: Low/Fast, 5: Medium, 10: High, 20+: Very High)
INFERENCE_STEPS=5

# --- Security ---
# Path to the JSON file storing API token hashes (raw tokens are never stored)
TOKEN_STORE_PATH=./tokens.json
# Enable a sample token for testing purposes (true/1 or false/0).
# Dev/test only: never enable in production.
ENABLE_SAMPLE_TOKEN=false
# Set to false to allow API access without authentication (dev only).
SONICBOOM_AUTH_REQUIRED=true
# Restrict audio queue file access to this directory.
# REQUIRED when the playback feature is enabled (default build).
ALLOWED_AUDIO_DIR=./audio
# Maximum character length for TTS input text (Unicode characters)
MAX_TEXT_LENGTH=10000
# Hard maximum chunk size for text splitting (Unicode characters)
MAX_CHUNK_CHARS=200
# Request timeout in seconds
REQUEST_TIMEOUT_SECS=120
# Inference admission control: concurrent executions and pending queue size.
# Saturated requests are rejected with 429 instead of queueing unboundedly.
MAX_CONCURRENT_INFERENCE=1
MAX_PENDING_INFERENCE=8
# Per-token rate limit for expensive TTS endpoints (requests per window).
# Set TTS_RATE_LIMIT_REQUESTS=0 to disable (not recommended).
TTS_RATE_LIMIT_REQUESTS=20
TTS_RATE_LIMIT_WINDOW_SECS=60
# HTTP body limits in bytes (enforced before full allocation).
TTS_MAX_BODY_BYTES=65536
OPENAI_MAX_BODY_BYTES=65536
QUEUE_MAX_BODY_BYTES=16384
ADMIN_MAX_BODY_BYTES=16384
# Reverse proxy: never trust forwarded client-IP headers unless the socket
# peer is one of TRUSTED_PROXIES (comma-separated IPs or CIDRs).
TRUST_PROXY=false
# TRUSTED_PROXIES=10.0.0.1,10.0.0.0/24
# Admin session cookie: set true when serving HTTPS in production.
COOKIE_SECURE=false
# Send Strict-Transport-Security: only when all traffic is known-HTTPS.
ENABLE_HSTS=false
# Admin session inactivity expiry in seconds (default: 8h).
ADMIN_SESSION_EXPIRY_SECS=28800
# Directory for temporary TTS playback files.
TEMP_AUDIO_DIR=./temp_audio

# --- Logging ---
# Directory for log files
LOG_DIR=./logs
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Enable/disable logging to file
LOG_TO_FILE=true
# Enable/disable logging to standard output
LOG_TO_STDOUT=true
